# Copy to .env.local for `npm run dev` (git-ignored). Not secrets, but keep real values out of the repo.
# Values are the outputs of deploy/entra.sh (az deployment group show -g rg-cupboard-tracker -n cupboard-entra).
VITE_TENANT_ID=<tenantId>
VITE_SPA_CLIENT_ID=<spaClientId>
VITE_API_SCOPE=api://<tenantId>/cupboard-tracker-api/access_as_user
# The API Function app (it allows http://localhost:5173 in CORS).
VITE_API_BASE_URL=https://<api-function-app>.azurewebsites.net
