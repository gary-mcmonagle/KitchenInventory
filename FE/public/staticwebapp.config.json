{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/version.json", "/favicon.svg"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  },
  "routes": [{ "route": "/version.json", "headers": { "Cache-Control": "no-store" } }]
}
