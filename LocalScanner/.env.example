# Copy to /etc/cupboard-tracker/pi.env on the Pi (never commit real values).
# Base URL of the ingest Function app, without a trailing slash.
INGEST_URL=https://<ingest-function-app>.azurewebsites.net
# Name and value of the auth header sent with every ingest call.
# For a function key the name is x-functions-key; the value is the key.
INGEST_AUTH_HEADER_NAME=x-functions-key
INGEST_AUTH_HEADER_VALUE=<function-key>
# Optional: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
