# Copy to /etc/cupboard-tracker/pi.env on the Pi (never commit real values).
# Base URL of the ingest Function app, without a trailing slash.
INGEST_URL=https://<ingest-function-app>.azurewebsites.net
# Name and value of the auth header sent with every ingest call.
# For a function key the name is x-functions-key; the value is the key.
INGEST_AUTH_HEADER_NAME=x-functions-key
INGEST_AUTH_HEADER_VALUE=<function-key>
# This hub's ID (the Pi). The simulator uses the same value, so simulated data lines up with the real Pi.
HUB_ID=cupboard-pi
# Devices, their roles, and (on the Pi) the scanner port each dongle is plugged into: deviceId=in|out@<port>,
# comma-separated. The port is the dongle's /dev/input/by-path name without "-event-kbd" (spike #27).
# The simulator uses the same variable and ignores the ports.
SCANNERS=scanner-in=in@platform-3f980000.usb-usb-0:1.5:1.0,scanner-out=out@platform-3f980000.usb-usb-0:1.2:1.0
# Optional: where the durable scan queue lives (default /var/lib/cupboard-tracker/scan-queue.sqlite3).
# SCAN_QUEUE_PATH=/var/lib/cupboard-tracker/scan-queue.sqlite3
# Optional: DEBUG, INFO (default), WARNING, ERROR.
LOG_LEVEL=INFO
